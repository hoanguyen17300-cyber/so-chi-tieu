{
  "name": "Sổ chi tiêu nhà mình",
  "short_name": "Sổ chi tiêu",
  "description": "Ghi chi tiêu gia đình, phân ví nhanh từ biên lai ngân hàng",
  "lang": "vi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFEFC2",
  "theme_color": "#E0A200",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{"name": "media", "accept": ["image/*"]}]
    }
  }
}
